+/// A wasm32 build never starts a child: the engines that need one aren't part of it.
+#[cfg(target_arch = "wasm32")]
+pub struct Leash;
+
+#[cfg(target_arch = "wasm32")]
+impl Leash {
+    pub fn new(_child: &Child) -> std::io::Result<Self> {
+        Err(std::io::Error::new(std::io::ErrorKind::Unsupported, "no child processes in wasm"))
+    }
+
+    pub fn memory(&self) -> u64 {
+        0
+    }
+}
