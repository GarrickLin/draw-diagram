+#[cfg(target_arch = "wasm32")]
+pub mod supplied {
+    use std::sync::Mutex;
+
+    pub static BUNDLED: Mutex<Vec<Vec<u8>>> = Mutex::new(Vec::new());
+    pub static EXTRA: Mutex<Vec<Vec<u8>>> = Mutex::new(Vec::new());
+}
+
+/// The bundled fonts' bytes, in FILES order.
+#[cfg(target_arch = "wasm32")]
+fn font_bytes() -> Result<Vec<Vec<u8>>, Error> {
+    let fonts = supplied::BUNDLED.lock().unwrap().clone();
+    match fonts.len() {
+        n if n == FILES.len() => Ok(fonts),
+        _ => Err(Error::fonts_missing(FILES[0])),
+    }
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+fn font_bytes() -> Result<Vec<Vec<u8>>, Error> {
+    let read = |file: &PathBuf| {
+        fs::read(file)
+            .map_err(|e| Error::internal(&format!("can't read the font {}: {e}", file.display())))
+    };
+    fonts()?.iter().map(read).collect()
+}
+
+/// Adds the computer's fonts to `db`; in wasm, the extra fonts the host supplied.
+pub fn load_system(db: &mut Database) {
+    #[cfg(target_arch = "wasm32")]
+    for data in supplied::EXTRA.lock().unwrap().iter() {
+        db.load_font_data(data.clone());
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    db.load_system_fonts();
+}
