diff --color -ruN '--exclude=target' '--exclude=cmp' '--exclude=*.mjs' '--exclude=*.png' '--exclude=*.log' drw-base/src/wasm.rs /tmp/drw/src/wasm.rs
--- a/src/wasm.rs	1970-01-01 08:00:00.000000000 +0800
+++ b/src/wasm.rs	2026-11-24 17:08:15.554029654 +0800
@@ -0,0 +1,222 @@
+//! The C ABI a wasm32 build exports for the draw.io renderer.
+//!
+//! The host (Node) owns files and fonts: it copies the diagram's text into memory it got from
+//! `alloc`, hands over the bundled Liberation fonts (and any extra fonts that stand in for the
+//! computer's, such as a CJK one) with `add_font`, and calls `render` or `check`. Each call leaves
+//! its output bytes and a JSON report in this module, which `out_ptr`/`out_len` and
+//! `meta_ptr`/`meta_len` point at until the next call. The report has the same fields as the
+//! CLI's `--json`: `{width, height, scale, page, pages, warnings}`, or `{error}`.
+//!
+//! Nothing here reads a file, the clock or the network, so a run is the same on every host.
+
+use std::path::Path;
+use std::sync::Mutex;
+use std::time::Duration;
+
+use serde_json::{Value, json};
+
+use crate::drawio;
+use crate::engine::{self, Job, Task};
+use crate::error::{Error, Warning};
+use crate::input::Lines;
+use crate::output::To;
+use crate::raster;
+use crate::svg;
+
+struct Out {
+    bytes: Vec<u8>,
+    meta: Vec<u8>,
+}
+
+static OUT: Mutex<Out> = Mutex::new(Out {
+    bytes: Vec::new(),
+    meta: Vec::new(),
+});
+
+/// `len` bytes the host may write into; give them back with `dealloc`.
+#[unsafe(no_mangle)]
+pub extern "C" fn alloc(len: usize) -> *mut u8 {
+    let mut buf = Vec::<u8>::with_capacity(len.max(1));
+    let ptr = buf.as_mut_ptr();
+    std::mem::forget(buf);
+    ptr
+}
+
+/// Frees what `alloc(len)` gave.
+///
+/// # Safety
+/// `ptr` must come from `alloc(len)` with the same `len`, and not be freed before.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn dealloc(ptr: *mut u8, len: usize) {
+    // SAFETY: the caller passes back exactly what `alloc` made.
+    unsafe { drop(Vec::from_raw_parts(ptr, 0, len.max(1))) };
+}
+
+/// Takes a font: `kind` 0 is the next of the bundled fonts, in the order of `raster::FILES`;
+/// 1 is an extra font used only for characters the bundled ones lack. Returns 0, else 1 when the
+/// bytes aren't a font.
+///
+/// # Safety
+/// `ptr` and `len` must describe bytes the host wrote with `alloc`.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn add_font(kind: u32, ptr: *const u8, len: usize) -> u32 {
+    // SAFETY: the host wrote `len` bytes at `ptr`.
+    let data = unsafe { std::slice::from_raw_parts(ptr, len) }.to_vec();
+    if skrifa::FontRef::new(&data).is_err() && skrifa::raw::FileRef::new(&data).is_err() {
+        return 1;
+    }
+    let list = match kind {
+        0 => &raster::supplied::BUNDLED,
+        _ => &raster::supplied::EXTRA,
+    };
+    list.lock().unwrap().push(data);
+    0
+}
+
+/// Draws the diagram of `len` bytes at `ptr` as SVG (`to` 0) or PNG (`to` 1) at `scale`
+/// (0 for the CLI's default of 2), on the page named by the `page_len` bytes at `page_ptr`
+/// (none when `page_len` is 0). Returns 0 when it drew, 1 when the report holds an error.
+///
+/// # Safety
+/// Each pointer and length must describe bytes the host wrote with `alloc`.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn render(
+    ptr: *const u8,
+    len: usize,
+    to: u32,
+    scale: f64,
+    page_ptr: *const u8,
+    page_len: usize,
+) -> u32 {
+    // SAFETY: as the caller promises.
+    let (text, page) = unsafe { inputs(ptr, len, page_ptr, page_len) };
+    let to = if to == 1 { To::Png } else { To::Svg };
+    let scale = if scale > 0.0 { scale } else { 2.0 };
+    let result = draw(&text, page.as_deref(), to, scale);
+    finish(result)
+}
+
+/// Checks the diagram without drawing an image. Returns 0 when it is valid, 1 when the report
+/// holds an error; its warnings are in the report either way.
+///
+/// # Safety
+/// As for `render`.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn check(
+    ptr: *const u8,
+    len: usize,
+    page_ptr: *const u8,
+    page_len: usize,
+) -> u32 {
+    // SAFETY: as the caller promises.
+    let (text, page) = unsafe { inputs(ptr, len, page_ptr, page_len) };
+    let task = task(&text, page.as_deref(), To::Svg);
+    let result = drawio::check(&task).map(|checked| {
+        let warnings: Vec<Value> = checked.warnings.iter().map(Warning::json).collect();
+        (Vec::new(), json!({"valid": true, "errors": [], "warnings": warnings}))
+    });
+    finish(result)
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn out_ptr() -> *const u8 {
+    OUT.lock().unwrap().bytes.as_ptr()
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn out_len() -> usize {
+    OUT.lock().unwrap().bytes.len()
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn meta_ptr() -> *const u8 {
+    OUT.lock().unwrap().meta.as_ptr()
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn meta_len() -> usize {
+    OUT.lock().unwrap().meta.len()
+}
+
+unsafe fn inputs(
+    ptr: *const u8,
+    len: usize,
+    page_ptr: *const u8,
+    page_len: usize,
+) -> (String, Option<String>) {
+    // SAFETY: the caller of the export promises both ranges.
+    let text = unsafe { std::slice::from_raw_parts(ptr, len) };
+    let text = String::from_utf8_lossy(text).into_owned();
+    let page = (page_len > 0).then(|| {
+        // SAFETY: as above.
+        let page = unsafe { std::slice::from_raw_parts(page_ptr, page_len) };
+        String::from_utf8_lossy(page).into_owned()
+    });
+    (text, page)
+}
+
+fn task<'a>(text: &'a str, page: Option<&'a str>, to: To) -> Task<'a> {
+    Task {
+        name: "diagram",
+        lines: Lines::new(text),
+        job: Job {
+            stdin: text.as_bytes(),
+            dir: Path::new("."),
+            env: vec![],
+            limit: Duration::from_secs(60),
+            memory: engine::MEMORY_LIMIT,
+        },
+        background: None,
+        page,
+        allow_network: false,
+        to,
+    }
+}
+
+/// What `Opened::draw` and `Opened::picture` do in run.rs, for draw.io only.
+fn draw(text: &str, page: Option<&str>, to: To, scale: f64) -> Result<(Vec<u8>, Value), Error> {
+    let r = drawio::render(&task(text, page, to))?;
+    let (svg, removed) = svg::clean(&String::from_utf8_lossy(&r.svg))
+        .map_err(|e| Error::internal(&format!("the engine's SVG isn't valid XML: {e}")))?;
+    let mut warnings = r.warnings;
+    if removed + r.removed > 0 {
+        warnings.push(Warning::unsafe_content_removed(removed + r.removed));
+    }
+    let page = r.page.map(|p| p.json());
+    let pages: Vec<Value> = r.pages.iter().map(|p| p.json()).collect();
+    let (bytes, width, height, scale) = match to {
+        To::Svg => {
+            let (width, height) = svg::size(&svg);
+            (svg.into_bytes(), width, height, None)
+        }
+        To::Png => {
+            let (width, height) = svg::css_size(&svg);
+            let (scale, reduced) = raster::fit(width, height, scale)?;
+            warnings.extend(reduced);
+            let png = raster::png(&svg, scale, raster::SANS, &mut warnings)?;
+            (png.bytes, png.width, png.height, Some(scale))
+        }
+    };
+    let warnings: Vec<Value> = warnings.iter().map(Warning::json).collect();
+    let meta = json!({
+        "to": if to == To::Png { "png" } else { "svg" },
+        "width": width,
+        "height": height,
+        "scale": scale,
+        "page": page,
+        "pages": pages,
+        "warnings": warnings,
+    });
+    Ok((bytes, meta))
+}
+
+fn finish(result: Result<(Vec<u8>, Value), Error>) -> u32 {
+    let (bytes, meta, code) = match result {
+        Ok((bytes, meta)) => (bytes, meta, 0),
+        Err(e) => (Vec::new(), json!({"error": e.json()}), 1),
+    };
+    let mut out = OUT.lock().unwrap();
+    out.bytes = bytes;
+    out.meta = serde_json::to_vec(&meta).unwrap_or_default();
+    code
+}
