+# draw-diagram: layout measures text with the skill's width table (Liberation Sans, which has
+# Helvetica's widths), the same table lib/text-width.js reads, instead of the bundled Noto font.
+# draw.io shows the labels in Helvetica, so boxes are sized for the font they are drawn in.
+_WIDTHS = None
+
+
+def _width_table():
+    global _WIDTHS
+    if _WIDTHS is None:
+        import json
+        import os
+        path = os.environ.get("DRAW_DIAGRAM_WIDTHS") or Path(__file__).resolve().parents[3] / "data" / "widths.json"
+        with open(path, encoding="utf-8") as stream:
+            _WIDTHS = json.load(stream)
+    return _WIDTHS
+
+
+def _is_wide(code):
+    return (0x1100 <= code <= 0x115F or 0x2E80 <= code <= 0xA4CF or 0xAC00 <= code <= 0xD7A3
+            or 0xF900 <= code <= 0xFAFF or 0xFE30 <= code <= 0xFE4F or 0xFF00 <= code <= 0xFF60
+            or 0xFFE0 <= code <= 0xFFE6 or code >= 0x1F000)
+
+
+def text_em(text, bold=False):
+    """Width of one line in 1/1000 em; the rules of lib/text-width.js textEm."""
+    table = _width_table()
+    style = table["bold" if bold else "regular"]
+    fallback = style["ascii"][ord(table["fallback"]) - 32]
+    em = 0
+    for ch in str(text):
+        code = ord(ch)
+        if 32 <= code <= 126:
+            em += style["ascii"][code - 32]
+        elif _is_wide(code):
+            em += table["unitsPerEm"] * table["wideEm"]
+        elif ch in style["extra"]:
+            em += style["extra"][ch]
+        elif code < 32:
+            pass
+        else:
+            em += fallback
+    return em
+
+
+class WidthFace:
+    """What layout needs of a PIL font: `size` and `getlength`."""
+
+    def __init__(self, size):
+        self.size = size
+
+    def getlength(self, text):
+        return text_em(text) * self.size / _width_table()["unitsPerEm"]
+
+
