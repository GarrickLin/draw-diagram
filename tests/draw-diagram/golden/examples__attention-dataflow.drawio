<UserObject id="mask" label="Causal mask M&lt;br&gt;&lt;small&gt;N × N&lt;/small&gt;" tooltip="M_ij = 0 for j &lt;= i, otherwise -inf&#10;shape: N × N"><mxCell style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontColor=#1B1F24;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="g_inputs"><mxGeometry x="500" y="50" width="120" height="80" as="geometry" /></mxCell></UserObject>
<UserObject id="scores" label="QK^T&lt;br&gt;&lt;small&gt;S = QK^T · N × N&lt;/small&gt;" tooltip="S = QK^T&#10;contraction over d_k&#10;shape: N × N"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="g_ops"><mxGeometry x="20" y="50" width="140" height="68" as="geometry" /></mxCell></UserObject>
<UserObject id="scale_mask" label="Scale + mask&lt;br&gt;&lt;small&gt;Z = S / sqrt(d_k) + M · N × N&lt;/small&gt;" tooltip="Z = S / sqrt(d_k) + M&#10;shape: N × N"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="g_ops"><mxGeometry x="205" y="50" width="140" height="68" as="geometry" /></mxCell></UserObject>
<UserObject id="softmax" label="Row-wise softmax&lt;br&gt;&lt;small&gt;P = softmax(Z) · N × N&lt;/small&gt;" tooltip="P = softmax(Z)&#10;normalized across key positions&#10;shape: N × N"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E5;strokeColor=#F0B48A;fontColor=#1B1F24;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="g_ops"><mxGeometry x="389" y="50" width="140" height="68" as="geometry" /></mxCell></UserObject>
