<UserObject id="q" label="Q&lt;br&gt;&lt;small&gt;N × d_k&lt;/small&gt;" tooltip="shape: N × d_k"><mxCell style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontColor=#1B1F24;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="g_inputs"><mxGeometry x="20" y="50" width="120" height="80" as="geometry" /></mxCell></UserObject>
