<mxfile host="draw-diagram" type="device">
  <diagram id="page-1" name="Tiled Online Attention">
    <mxGraphModel adaptiveColors="auto">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="g_resident" value="Resident on chip" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#D5DAE1;fontColor=#1B1F24;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="440" width="312" height="140" as="geometry" /></mxCell>
<mxCell id="g_stream" value="KV tile j" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#F4F8FF;strokeColor=#D5DAE1;fontColor=#1B1F24;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="10" y="135" width="292" height="134" as="geometry" /></mxCell>
<mxCell id="g_iteration" value="Repeat over KV tiles" style="swimlane;startSize=30;whiteSpace=wrap;html=1;fillColor=#F6FBF7;strokeColor=#D5DAE1;fontColor=#1B1F24;fontSize=14;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="481" y="0" width="196" height="404" as="geometry" /></mxCell>
<UserObject id="q_tile" label="Q_i&lt;br&gt;&lt;small&gt;B_r × d_k&lt;/small&gt;" tooltip="shape: B_r × d_k&#10;On chip; reused across j"><mxCell style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontColor=#1B1F24;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="g_resident"><mxGeometry x="12" y="45" width="120" height="80" as="geometry" /></mxCell></UserObject>
<UserObject id="k_tile" label="K_j&lt;br&gt;&lt;small&gt;B_c × d_k&lt;/small&gt;" tooltip="shape: B_c × d_k&#10;Loaded from HBM each j"><mxCell style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontColor=#1B1F24;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="g_stream"><mxGeometry x="12" y="42" width="120" height="80" as="geometry" /></mxCell></UserObject>
<UserObject id="v_tile" label="V_j&lt;br&gt;&lt;small&gt;B_c × d_v&lt;/small&gt;" tooltip="shape: B_c × d_v&#10;Loaded from HBM each j"><mxCell style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontColor=#1B1F24;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="g_stream"><mxGeometry x="160" y="42" width="120" height="80" as="geometry" /></mxCell></UserObject>
<UserObject id="scores" label="Tile scores&lt;br&gt;&lt;small&gt;S_j = Q_i K_j^T / sqrt(d_k) · B_r × B_c&lt;/small&gt;" tooltip="S_j = Q_i K_j^T / sqrt(d_k)&#10;shape: B_r × B_c&#10;Transient on chip"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="g_iteration"><mxGeometry x="28" y="42" width="140" height="86" as="geometry" /></mxCell></UserObject>
<UserObject id="online" label="Online row normalization" tooltip="m_new = max(m, rowmax(S_j))&#10;alpha = exp(m - m_new)&#10;P_j = exp(S_j - m_new)&#10;shape: P_j: B_r × B_c; m_new, alpha: B_r&#10;Transient on chip"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E5;strokeColor=#F0B48A;fontColor=#1B1F24;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="g_iteration"><mxGeometry x="28" y="174" width="140" height="86" as="geometry" /></mxCell></UserObject>
<UserObject id="accumulate" label="Update accumulators&lt;br&gt;&lt;small&gt;l_new: B_r; A_new: B_r × d_v&lt;/small&gt;" tooltip="l_new = alpha*l + rowsum(P_j)&#10;A_new = diag(alpha)A + P_j V_j&#10;shape: l_new: B_r; A_new: B_r × d_v&#10;On chip"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="g_iteration"><mxGeometry x="28" y="306" width="140" height="86" as="geometry" /></mxCell></UserObject>
<UserObject id="state" label="Running state (m, l, A)&lt;br&gt;&lt;small&gt;m = -inf, l = 0, A = 0 · m, l: B_r; A: B_r × d_v&lt;/small&gt;" tooltip="m = -inf, l = 0, A = 0&#10;shape: m, l: B_r; A: B_r × d_v&#10;On chip; persists across j"><mxCell style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E7F6EC;strokeColor=#8BCB9F;fontColor=#1B1F24;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="g_resident"><mxGeometry x="160" y="42" width="140" height="86" as="geometry" /></mxCell></UserObject>
<UserObject id="normalize" label="Final row normalization&lt;br&gt;&lt;small&gt;O_i = diag(l)^(-1)A · B_r × d_v&lt;/small&gt;" tooltip="O_i = diag(l)^(-1)A&#10;shape: B_r × d_v"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="509" y="467" width="140" height="86" as="geometry" /></mxCell></UserObject>
<UserObject id="output" label="O_i&lt;br&gt;&lt;small&gt;B_r × d_v&lt;/small&gt;" tooltip="shape: B_r × d_v&#10;Output to HBM"><mxCell style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontColor=#1B1F24;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="96" y="616" width="120" height="80" as="geometry" /></mxCell></UserObject>
<mxCell id="q_tile-scores" value="Q_i" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;fontSize=12;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="q_tile" target="scores"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-12" y="525" /><mxPoint x="-12" y="85" /></Array></mxGeometry></mxCell>
<mxCell id="k_tile-scores" value="K_j" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;fontSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="k_tile" target="scores"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="82" y="85" /></Array></mxGeometry></mxCell>
<mxCell id="scores-online" value="S_j" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="g_iteration" source="scores" target="online"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="state-online" value="previous m" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="state" target="online"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="405" y="525" /><mxPoint x="405" y="217" /></Array></mxGeometry></mxCell>
<mxCell id="online-accumulate" value="P_j, alpha, m_new" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="g_iteration" source="online" target="accumulate"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="v_tile-accumulate" value="V_j" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="v_tile" target="accumulate"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="230" y="349" /></Array></mxGeometry></mxCell>
<mxCell id="state-accumulate" value="previous l, A" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;fontSize=12;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="state" target="accumulate"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="230" y="349" /></Array></mxGeometry></mxCell>
<mxCell id="accumulate-state" value="m_new, l_new, A_new" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="accumulate" target="state"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="579" y="437" /><mxPoint x="230" y="437" /></Array></mxGeometry></mxCell>
<mxCell id="state-normalize" value="final l, A; after all KV tiles" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;fontSize=12;exitX=1;exitY=0.326;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="state" target="normalize"><mxGeometry relative="1" as="geometry" /></mxCell>
<mxCell id="normalize-output" value="O_i" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8A94A6;fontColor=#5A626E;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Helvetica;" edge="1" parent="1" source="normalize" target="output"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="579" y="656" /></Array></mxGeometry></mxCell>
</root>
</mxGraphModel>
  </diagram>
</mxfile>
