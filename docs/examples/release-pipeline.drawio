<mxCell id="notify" value="Notify the author" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontSize=14;" vertex="1" parent="1"><mxGeometry x="215" y="207" width="140" height="60" as="geometry" /></mxCell>
