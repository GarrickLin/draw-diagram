erDiagram
    CUSTOMER {
        int id PK
        string email
        string name
    }
    ORDER {
        int id PK
        int customer_id FK
        date placed_at
        string status
    }
    ORDER_ITEM {
        int order_id FK
        int product_id FK
        int quantity
    }
    PRODUCT {
        int id PK
        string sku
        decimal price
    }
    CUSTOMER ||--o{ ORDER : places
    ORDER ||--|{ ORDER_ITEM : contains
    PRODUCT ||--o{ ORDER_ITEM : "ordered as"
